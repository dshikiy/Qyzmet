# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=20"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Platform Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
COMMISSION_RATE="0.10"

# Admin Bootstrap (used only by npm run db:bootstrap-admin)
ADMIN_EMAIL="admin@qyzmettap.kz"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="QyzmetTap Әкімшісі"

